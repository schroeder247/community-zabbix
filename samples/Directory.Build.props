<!--
The samples are applications a reader copies from: they take the solution's props directly, skip what only a package needs,
and leave undocumented what only they use. .editorconfig's samples section turns off the rules that are for libraries.
-->
<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublicApiTracked>false</IsPublicApiTracked>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
